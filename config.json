{
  "ignore_dirs": [
    ".git", ".devin", "agents-workflow", "node_modules", "venv", ".venv",
    "__pycache__", ".pytest_cache", ".ruff_cache", "dist", "build",
    ".idea", ".vscode", "*.egg-info"
  ],
  "ignore_files": [
    "*.lock", "*.min.js", "*.min.css", ".guarddog_cache.json",
    "guarddog_report.*", "package-lock.json", "poetry.lock"
  ],
  "scan_extensions": [
    ".py", ".js", ".ts", ".jsx", ".tsx", ".go", ".java", ".rb", ".php",
    ".yaml", ".yml", ".toml", ".env", ".sh", ".bat", ".ps1", ".cfg",
    ".ini", ".sql", ".Dockerfile", ".dockerfile"
  ],
  "max_file_size_kb": 256,
  "fail_on": "critical",
  "llm": {
    "enabled": true,
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "max_files": 40
  }
}
